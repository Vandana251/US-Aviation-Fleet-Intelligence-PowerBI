{
  "name": "Aviation Executive Dark",
  "dataColors": [
    "#38BDF8",
    "#818CF8",
    "#10B981",
    "#F59E0B",
    "#F43F5E",
    "#A855F7",
    "#06B6D4",
    "#EC4899",
    "#3B82F6",
    "#14B8A6"
  ],
  "background": "#070D18",
  "foreground": "#F8FAFC",
  "tableAccent": "#38BDF8",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#111C35"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E2E50"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 70
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1E2E50"
              }
            },
            "showAxisTitle": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#070D18"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#162444"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#38BDF8"
              }
            },
            "radius": 12
          }
        ]
      }
    }
  }
}